# Run from the project root: latexmk main.tex
# XeLaTeX writes XDV; latexmk runs xdvipdfmx only after references settle.
$pdf_mode = 5;
$out_dir = 'build';
$out2_dir = 'build';
$success_cmd = 'internal qft_publish_pdf';
$xelatex = 'xelatex -shell-escape -synctex=1 -interaction=nonstopmode -file-line-error -halt-on-error %O %S';
$max_repeat = 6;

use Digest::SHA ();
use File::Compare ();
use File::Copy ();
use File::Path qw(make_path remove_tree);

# Publish only after a successful build; do not replace the last good PDF
# with an intermediate result if a later XeLaTeX/Biber pass fails.
sub qft_publish_pdf {
    return 0 if -f 'main.pdf' && File::Compare::compare('build/main.pdf', 'main.pdf') == 0;
    File::Copy::copy('build/main.pdf', 'build/main.publish.pdf') or die "Cannot copy PDF: $!\n";
    rename('build/main.publish.pdf', 'main.pdf') or die "Cannot publish PDF: $!\n";
    return 0;
}

# Explicitly requested through the VS Code recipe or environment variable.
# Never remove the last successful main.pdf.
if ($ENV{'QFT_TIKZ_REBUILD'}) {
    remove_tree('build/tikz');
}

# TikZ hashes picture bodies, but does not hash definitions used by them.
# A separate namespace invalidates pictures after shared definitions change.
my $qft_digest = Digest::SHA->new(256);
my @qft_dependencies = ('.latexmkrc', 'packages.tex', 'tikz-cache.tex',
                        sort(glob('*.cls')), sort(glob('*.sty')));
for my $qft_path (@qft_dependencies) {
    open my $qft_file, '<:raw', $qft_path or die "Cannot read $qft_path: $!\n";
    local $/;
    my $qft_contents = <$qft_file>;
    $qft_digest->add($qft_path, "\0", $qft_contents, "\0");
    close $qft_file;
}
open my $qft_main, '<:raw', 'main.tex' or die "Cannot read main.tex: $!\n";
my $qft_preamble = do { local $/; <$qft_main> };
close $qft_main;
$qft_preamble =~ s/\\begin\{document\}.*\z//s;
$qft_digest->add($qft_preamble);
my $qft_key = substr($qft_digest->hexdigest, 0, 20);
make_path("build/tikz/$qft_key");

my $qft_enabled = $ENV{'QFT_TIKZ_DISABLE'} ? 0 : 1;
my $qft_config = "% Generated by .latexmkrc; do not edit.\n"
              . "\\def\\qfttikzprefix{tikz/$qft_key/}\n"
              . "\\def\\qfttikzcacheenabled{$qft_enabled}\n";
my $qft_previous = '';
if (open my $qft_old, '<:raw', 'build/tikz-config.tex') {
    local $/;
    $qft_previous = <$qft_old>;
    close $qft_old;
}
# Do not touch this input on an unchanged build: latexmk must remain a no-op.
if ($qft_previous ne $qft_config) {
    open my $qft_new, '>:raw', 'build/tikz-config.tex' or die "$!\n";
    print {$qft_new} $qft_config;
    close $qft_new;
}
